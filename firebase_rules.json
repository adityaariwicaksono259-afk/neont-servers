{
  "rules": {
    "users": {
      ".indexOn": ["username", "name"],
      "$uid": {
        ".read": "auth != null",
        ".write": "$uid === auth.uid",
        "username": { ".validate": "newData.isString() && newData.val().length <= 25" },
        "name": { ".validate": "newData.isString() && newData.val().length <= 50" }
      }
    },
    "usernames": {
      "$username": {
        ".read": "auth != null",
        ".write": "!data.exists() || data.val() === auth.uid"
      }
    },
    "chats": {
      "$roomId": {
        ".read": "auth != null && ($roomId.contains(auth.uid) || root.child('chats').child($roomId).child('members').child(auth.uid).exists())",
        ".write": "auth != null && ($roomId.contains(auth.uid) || root.child('chats').child($roomId).child('members').child(auth.uid).exists())",
        "messages": {
          "$messageId": {
            "text": { ".validate": "newData.isString() && newData.val().length <= 4000" },
            "senderId": { ".validate": "newData.val() === auth.uid" },
            "timestamp": { ".validate": "newData.isNumber()" }
          }
        }
      }
    },
    "groups": {
      "$groupId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "title": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "description": { ".validate": "newData.isString() && newData.val().length <= 500" }
      }
    },
    "typing": {
      "$roomId": {
        "$uid": {
          ".write": "$uid === auth.uid",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "blocks": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    }
  }
}
